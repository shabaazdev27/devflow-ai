# =============================================================================
# DevFlow AI — .gitignore
# Next.js (React) + FastAPI (Python) + SQLite + Playwright
# =============================================================================

# =============================================================================
# SECRETS & ENVIRONMENT VARIABLES
# Never commit credentials, API keys, or service account files
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json
*credentials*.json
google-credentials.json

# =============================================================================
# NODE / NEXT.JS
# =============================================================================
node_modules/
.pnp
.pnp.*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
build/
dist/

# Next.js cache
.next/cache/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Coverage reports
coverage/
.nyc_output/

# Vercel deployment
.vercel

# =============================================================================
# PYTHON / FASTAPI BACKEND
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST
*.whl

# Pytest & test cache
.pytest_cache/
.cache/
*.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Ruff / linters
.ruff_cache/

# =============================================================================
# DATABASES
# SQLite databases contain runtime data — never commit these
# =============================================================================
*.db
*.sqlite
*.sqlite3
devflow.db
test_devflow.db

# =============================================================================
# TESTING ARTIFACTS
# =============================================================================

# Playwright
test-results/
playwright-report/
playwright/.cache/
e2e/

# Vitest / Jest
coverage/

# =============================================================================
# EDITOR & IDE
# =============================================================================

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# =============================================================================
# MISC BUILD / TEMP FILES
# =============================================================================
*.log
*.tmp
*.temp
*.bak
*.orig
.turbo/
.sixth/
